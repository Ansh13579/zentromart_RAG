# IFM is selected automatically when IFM_API_KEY is present.
LLM_PROVIDER=ifm
IFM_API_KEY=your_ifm_api_key_here
IFM_MODEL=IFM/K2-Horizon-375B-A23B
IFM_BASE_URL=https://api.ifm.ai/v1
IFM_MAX_TOKENS=8192
IFM_MAX_RETRIES=3
IFM_TIMEOUT_SECONDS=120
IFM_REASONING_EFFORT=high

# Optional Hugging Face authentication used when downloading public models.
# Leave empty if you do not need authenticated downloads.
HF_TOKEN=your_huggingface_token_here
# Local multilingual CrossEncoder second-stage reranker. The public model is
# downloaded on the first RAG request and runs on CPU to fit low-VRAM systems.
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_CANDIDATE_COUNT=25
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=384
GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_LANGUAGE=en-IN
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Pranav
GNANI_TTS_LANGUAGE=en-IN
GNANI_MAX_AUDIO_DURATION_SECONDS=60
VOICE_OUTPUT_DIR=sample_outputs
